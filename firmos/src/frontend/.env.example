# Postgres 16 via firmos/docker-compose.yml (`npm run db:up` from this directory).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/firmos

# Better Auth (ADR-0005). REQUIRED in production - src/server/auth/config.ts
# throws at import if this is empty there. In dev/test it may be left unset;
# a documented dev-only default ("firmos-dev-only-secret-...") is used instead.
# Generate a real one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL the auth routes are served from.
BETTER_AUTH_URL=http://localhost:3000

# Client/CPA portal kill switch (HANDOFF §12). "1" enables the portal; the
# app_settings feature_flags.client_portal_enabled key can also enable it.
# When disabled, portal endpoints and pages behave as 404. Default off.
FIRMOS_PORTAL_ENABLED=

# Dev/test only: lets src/server/auth/dev-links.ts hand back the last
# portal magic link per email (local dev + e2e). NEVER set in production.
FIRMOS_DEV_LINKS=
