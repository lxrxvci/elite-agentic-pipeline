# Postgres 16 via firmos/docker-compose.yml (`npm run db:up` from this directory).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/firmos

# Better Auth (ADR-0005). REQUIRED in production - src/server/auth/config.ts
# throws at import if this is empty there. In dev/test it may be left unset;
# a documented dev-only default ("firmos-dev-only-secret-...") is used instead.
# Generate a real one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL the auth routes are served from.
BETTER_AUTH_URL=http://localhost:3000

# Client/CPA portal kill switch (HANDOFF §12). "1" enables the portal; the
# app_settings feature_flags.client_portal_enabled key can also enable it.
# When disabled, portal endpoints and pages behave as 404. Default off.
FIRMOS_PORTAL_ENABLED=

# Dev/test only: lets src/server/auth/dev-links.ts hand back the last
# portal magic link per email (local dev + e2e). NEVER set in production.
FIRMOS_DEV_LINKS=

# Outbound email (src/server/email.ts). Production REQUIRED: without
# RESEND_API_KEY, sendEmail throws in production (magic links would not
# arrive). Unset outside production = dev driver (console + dev-links stash).
RESEND_API_KEY=
# From-address; must be on a verified Resend domain in production. Defaults
# to "FirmOS <onboarding@resend.dev>" (Resend's shared test domain).
FIRMOS_EMAIL_FROM=

# Inbound client replies (correspondence hub). The svix signing secret from
# the Resend webhook ("whsec_..."); /api/webhooks/resend verifies it. Unset:
# production answers 503, dev/test accepts and logs unsigned payloads.
RESEND_WEBHOOK_SECRET=

# Correspondence hub identity/links: the firm-facing name clients see in
# branded mail, and the public base URL for portal/review links.
FIRMOS_FIRM_NAME=
FIRMOS_APP_URL=

# Call-notes -> intake autofill (ADR-0006). Google AI Studio key for the
# Gemini extraction. When unset (or INTAKE_EXTRACT_MOCK=1) the deterministic
# stub extractor runs instead, so dev/CI/e2e never require a live model.
GEMINI_API_KEY=
# Extraction model; defaults to gemini-3.5-flash (current flash-class).
INTAKE_EXTRACT_MODEL=
# "1" forces the stub extractor even when GEMINI_API_KEY is set.
INTAKE_EXTRACT_MOCK=

# Client credential vault (Phase 3B; src/server/vault-crypto.ts). AES-256-GCM
# key, base64-encoded 32 bytes. REQUIRED in production - encrypt/decrypt throw
# without it (reads of the masked list still work). Unset outside production =
# a deterministic, publicly known DEV-ONLY key. Generate with:
#   openssl rand -base64 32
FIRMOS_ENCRYPTION_KEY=
